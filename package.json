{
  "name": "pi-extension-reloader",
  "version": "0.2.0",
  "description": "Reload Pi runtime resources and automatically continue the pending task without restarting the session.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "hot-reload",
    "developer-tools"
  ],
  "author": "Robert Fischer",
  "license": "MIT",
  "homepage": "https://github.com/metzzo/pi-extension-loader#readme",
  "bugs": {
    "url": "https://github.com/metzzo/pi-extension-loader/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metzzo/pi-extension-loader.git"
  },
  "files": [
    "index.ts",
    "CHANGELOG.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test tests/reloader.test.js",
    "test:e2e": "node integration/e2e.js",
    "test:package": "node scripts/package-smoke.js",
    "smoke": "pi --offline --no-extensions --extension ./index.ts --list-models",
    "release:check": "npm run check && npm test && npm run test:package && npm run smoke && npm audit --omit=dev --audit-level=high",
    "prepublishOnly": "npm run release:check"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "^22.15.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
