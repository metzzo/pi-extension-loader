{
  "name": "pi-extension-reloader",
  "version": "0.1.1",
  "description": "A Pi command and LLM tool for reloading extensions, skills, prompts, themes, and context files.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "index.ts",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/reloader.test.js",
    "test:e2e": "node integration/e2e.js",
    "smoke": "pi --offline --no-extensions --extension ./index.ts --list-models"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
